[Info]
localcoord = 320,240
doubleres = 4

[Files]
sff = fight.sff
snd = fight.snd
font1 = font/font2.fnt
font2 = font/timer.fnt
font3 = font/round.fnt
font4 = font/combo.fnt
font5 = font/wincount.fnt
fightfx.sff = fightfx.sff
fightfx.air = fightfx.air
common.snd = common.snd
fx1 = gofx.def; new ikemen fx

;-----------------------------------------------------------
[FightFx]
scale = 1

