{
  "name": "lifebar-viewer-web",
  "private": true,
  "version": "0.10.0",
  "description": "Static web viewer for OpenKakutou MUGEN/Ikemen GO lifebars — health/power bar UI, combo counter, round display, with live value simulation.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "biome check --write .",
    "wasm:download": "node scripts/download-wasm.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@openkakutou/web-ui-kit": "^0.13.0"
  }
}
